TOKEN=your-bot-token-here
DATABASE_URL="file:./dev.db"

# Optional: enables /stripe (admin-only). Use a restricted key with read access to Balance, Balance transactions, and Account.
STRIPE_SECRET_KEY=

# Orders: linked to the website's Supabase project (same data as the dashboard). See "Orders" in the README.
SUPABASE_URL=
# The PUBLIC anon key (Supabase dashboard -> Project Settings -> API). The website already ships it to browsers.
# This is NOT the service_role key — the bot never needs that one.
SUPABASE_ANON_KEY=
# A long random string you generate (e.g. `openssl rand -hex 32`). Register its hash in the database with
# supabase/bot-orders-secret.sql (generate it with `npm run -s orders:secret`).
BOT_API_SECRET=
