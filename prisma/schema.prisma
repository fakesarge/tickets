generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model config {
  key   String  @id
  value String?
}

model tickets {
  id           Int     @id @default(autoincrement())
  channelId    String  @unique
  messageId    String
  typeCodeName String
  creator      String
  invited      String  @default("[]")
  reason       String  @default("")
  createdAt    BigInt
  claimedBy    String?
  claimedAt    BigInt?
  closedBy     String?
  closedAt     BigInt?
  closeReason  String?
  transcriptId String?
  termsMessageId String?

  // Guided conversation flow state (see src/lib/flows)
  flowStep      String?
  flowMessageId String?
  flowHistory   String  @default("[]")
  flowSelections String @default("{}")
  flowResponses String  @default("{}")
  escalated     Boolean @default(false)
  staffTakeover Boolean @default(false)
}

// ── Affiliates (creator codes) ─────────────────────────────────────────────────────────────────────
// Lives entirely in the bot's own database. All money is stored as integer cents.

model affiliates {
  discordId      String @id
  code           String @unique // always stored UPPERCASE
  balanceCents   Int    @default(0) // available to withdraw
  earnedCents    Int    @default(0) // lifetime earnings
  withdrawnCents Int    @default(0) // lifetime paid out
  createdBy      String
  createdAt      BigInt
}

// One row per member currently using a code (a member supports one affiliate at a time).
model affiliateReferrals {
  memberId    String @id
  affiliateId String
  usedAt      BigInt

  @@index([affiliateId])
}

model affiliateWithdrawals {
  id              Int     @id @default(autoincrement())
  affiliateId     String
  amountCents     Int
  payoutDetails   String
  status          String  @default("pending") // pending | paid | rejected
  requestedAt     BigInt
  resolvedAt      BigInt?
  resolvedBy      String?
  note            String?
  payoutChannelId String?
  payoutMessageId String?

  @@index([affiliateId])
  @@index([status])
}

// Every balance change, so an affiliate's numbers can always be explained.
model affiliateLedger {
  id           Int     @id @default(autoincrement())
  affiliateId  String
  type         String // credit | debit | adjustment | withdrawal | refund
  amountCents  Int // signed change to the balance
  balanceAfter Int
  note         String?
  actor        String
  createdAt    BigInt

  @@index([affiliateId])
}

// VIP memberships are tracked here (not in Supabase). Admins set the expiry; reminderSentAt records
// that the "expires in 7 days" DM has gone out so it is only sent once per expiry date.
model vips {
  discordId      String  @id
  expiresAt      BigInt
  grantedBy      String
  grantedAt      BigInt
  reminderSentAt BigInt?
}
